{
  "name": "ai-vibe-composer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-assisted music composition with coding agents: write melodies and arrangements in TypeScript, use licensed sounds, render WAV/MP3 with Tone.js and Python DSP. Vibe 作曲：AI 辅助编曲与音频生成。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jogzh/ai-vibe-composer.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "test:palette": "node scripts/check-palette.mjs",
    "check": "npm test && npm run build",
    "render": "node scripts/render.mjs",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "assets:catalog": "node scripts/catalog-assets.mjs",
    "assets:check": "node scripts/catalog-assets.mjs --check"
  },
  "dependencies": {
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "1.64.0",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  },
  "keywords": [
    "ai-music",
    "ai-composer",
    "ai-composition",
    "ai-music-generation",
    "vibe-coding",
    "vibe-composing",
    "music-generation",
    "algorithmic-composition",
    "ai-agents",
    "generative-music",
    "tonejs",
    "web-audio",
    "typescript",
    "python",
    "audio-dsp",
    "sound-design",
    "sample-library",
    "cc0",
    "bgm",
    "AI作曲",
    "AI音乐生成",
    "Vibe作曲",
    "智能编曲",
    "音乐创作",
    "声音资产"
  ],
  "homepage": "https://github.com/Jogzh/ai-vibe-composer#readme",
  "bugs": {
    "url": "https://github.com/Jogzh/ai-vibe-composer/issues"
  }
}
